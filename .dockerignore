# Keep the build context small and avoid baking local artefacts into the image.
.git
.gitignore
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# Preview artefacts
docs/_screens/
docs/_slides/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Deployment descriptors not needed inside the image
Dockerfile
.dockerignore
render.yaml
